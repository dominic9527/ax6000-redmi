# =========================================================
# Redmi AX6000 U-Boot Mod
# Official OpenWrt v25.12.6
# =========================================================

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-ubootmod=y

# Initramfs recovery support
CONFIG_TARGET_ROOTFS_INITRAMFS=y


# =========================================================
# LuCI
# =========================================================

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# Argon Theme
CONFIG_PACKAGE_luci-theme-argon=y

# Temperature monitoring
CONFIG_PACKAGE_luci-app-temp=y


# =========================================================
# WireGuard
# =========================================================

CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y


# =========================================================
# Tailscale
# =========================================================

CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_kmod-tun=y


# =========================================================
# UPnP
# =========================================================

CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-app-upnp=y


# =========================================================
# PPPoE
# Keep PPPoE support
# No credentials preconfigured
# =========================================================

CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y


# =========================================================
# Lucky
# =========================================================

CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-lucky=y


# =========================================================
# Policy Based Routing
# Dual WAN / Device Routing / Domain Routing
# =========================================================

CONFIG_PACKAGE_pbr=y
CONFIG_PACKAGE_luci-app-pbr=y


# =========================================================
# DNS
# dnsmasq nftset support
# =========================================================

CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y


# =========================================================
# Network diagnostics
# =========================================================

CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_mtr=y

CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-bridge=y

CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_conntrack-tools=y

CONFIG_PACKAGE_nftables-json=y

CONFIG_PACKAGE_bind-tools=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_socat=y


# =========================================================
# System tools
# =========================================================

CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_procps-ng=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_strace=y

CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_jq=y


# =========================================================
# Wireless tools
# =========================================================

CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y


# =========================================================
# IPv6
# =========================================================

CONFIG_PACKAGE_ipv6helper=y
